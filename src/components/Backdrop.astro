---
// Minimal fixed backdrop behind the page: a low sun and two soft Aravalli ridge lines,
// drawn once for wide screens and once in portrait for phones.
// Layers drift slightly on scroll.
---
<div class="backdrop" aria-hidden="true">
  <svg class="backdrop-wide" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMax slice" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- Sun -->
    <g class="backdrop-layer" data-depth="0.06">
      <circle cx="1210" cy="560" r="96" stroke="var(--color-mustard)" stroke-width="2" opacity="0.45" />
    </g>

    <!-- Aravalli ridges -->
    <g class="backdrop-layer" data-depth="0.02">
      <path d="M-40 760C60 750 120 700 200 712c70 10 110 50 180 40 80-12 120-80 210-86 90-6 130 52 220 54 70 2 110-44 190-50 100-8 140 60 240 58 80-2 120-46 200-48 110-2 150 52 240 58" stroke="var(--color-primary)" stroke-width="1.6" opacity="0.14" />
      <path d="M-40 820c120-6 190-40 300-36 110 4 170 40 280 38 120-2 180-48 300-46 110 2 170 38 290 36 120-2 200-34 320-30 70 2 110 12 150 18" stroke="var(--color-mustard)" stroke-width="1.6" opacity="0.3" />
    </g>
  </svg>

  <!-- Portrait version for phones -->
  <svg class="backdrop-tall" viewBox="0 0 400 900" preserveAspectRatio="xMidYMax slice" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <g class="backdrop-layer" data-depth="0.05">
      <circle cx="292" cy="610" r="54" stroke="var(--color-mustard)" stroke-width="1.8" opacity="0.5" />
    </g>
    <g class="backdrop-layer" data-depth="0.02">
      <path d="M-20 712c40-6 64-30 100-26 34 4 52 26 88 24 40-2 58-36 98-38 38-2 58 22 92 22 22 0 34-6 62-10" stroke="var(--color-primary)" stroke-width="1.6" opacity="0.16" />
      <path d="M-20 752c50-4 84-22 130-20 46 2 74 22 120 20 46-2 74-24 116-22 24 2 40 8 74 12" stroke="var(--color-mustard)" stroke-width="1.6" opacity="0.34" />
    </g>
  </svg>
</div>

<script>
  // Gentle parallax: each layer drifts by its depth × scroll progress. Skipped for reduced motion.
  const layers = document.querySelectorAll<SVGGElement>('.backdrop-layer');
  if (layers.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? window.scrollY / max : 0;
      layers.forEach(layer => {
        const depth = Number(layer.dataset.depth || 0);
        layer.style.transform = `translate3d(0, ${-(progress * depth * 1000).toFixed(1)}px, 0)`;
      });
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
