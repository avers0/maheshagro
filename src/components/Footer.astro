---
import FurrowDivider from './FurrowDivider.astro';
import { branches } from '../data/branches';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navLinks = [[`${base}#about`,"About Us"],[`${base}#why-choose-us`,"Why Us"],[`${base}products`,"Products"],[`${base}#testimonials`,"Testimonials"],[`${base}#licenses`,"Licenses"],[`${base}#locations`,"Locations"],[`${base}#awards`,"Awards"],[`${base}#contact`,"Contact"]];
const toolLinks = [[`${base}tools/mandi`,"Mandi Prices"],[`${base}tools/weather`,"Weather"],[`${base}tools/calculator`,"Fertilizer Calculator"]];
const mainBranch = branches[0];
---
<footer class="relative">
  <FurrowDivider top="transparent" bottom="var(--color-footer)" line="var(--color-accent)" class="relative z-10 -mt-[clamp(32px,4.5vw,72px)]" />
  <div class="paper-grain paper-grain-dark -mt-px bg-footer text-white/70">
    <div class="container-custom pt-8 pb-10">
      <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
        <div>
          <a class="flex items-center gap-3 group" href={base}>
            <span class="w-14 h-14 rounded-full bg-paper p-1 flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
              <img src={`${base}Images/logo.png`} alt="Mahesh Agro Logo" class="w-full h-full object-contain" loading="lazy" />
            </span>
            <span class="font-display text-2xl font-semibold text-white whitespace-nowrap">Mahesh Agro</span>
          </a>
          <p class="mt-5 max-w-sm text-sm leading-relaxed">
            Empowering farmers since 1973 with genuine agricultural inputs and expert consultation for a prosperous harvest.
          </p>
          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-mustard/40 px-3 py-1 text-xs font-semibold text-mustard" data-language-static>
            <span lang="hi">स्थापना 1973</span><span aria-hidden="true">·</span><span>Est. 1973</span>
          </p>
        </div>

        <div>
          <h2 class="font-display text-lg text-white">Quick Links</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {navLinks.map(([href, label]) => (
              <li><a href={href} class="transition-colors hover:text-mustard">{label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-lg text-white">Farmer Tools</h2>
          <ul class="mt-4 space-y-2 text-sm">
            {toolLinks.map(([href, label]) => (
              <li><a href={href} class="transition-colors hover:text-mustard">{label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="font-display text-lg text-white">Visit Us</h2>
          <address class="mt-4 not-italic text-sm leading-relaxed space-y-3">
            <p>MAHESH AGRO SERVICE CENTRE DOLTA, RTO OFFICE, JAIPUR-KOTA ROAD, Madhosinghpura (Daulta)</p>
            <p><span class="text-white/50">Open daily ·</span> {mainBranch.hours}</p>
            <p><a href="tel:+919166029301" class="transition-colors hover:text-mustard">+91 91660 29301</a></p>
            <p><a href="mailto:contact@maheshagro.com" class="transition-colors hover:text-mustard">contact@maheshagro.com</a></p>
          </address>
          <a href="https://wa.me/919166029301" target="_blank" rel="noopener noreferrer" class="btn-accent mt-5 !py-2 !px-5 !text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/></svg>
            <span>WhatsApp Chat</span>
          </a>
        </div>
      </div>

      <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/45">
        <div class="flex items-center gap-1.5">
          <span>© {year} Mahesh Agro</span>
          <span class="opacity-50">|</span>
          <span class="flex items-center gap-1">Made with
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" class="text-mustard" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
          </span>
        </div>
        <div class="flex items-center gap-4">
          <a class="hover:text-mustard transition-colors" href={`${base}legal/`}>Terms &amp; Conditions</a>
          <span aria-hidden="true">|</span>
          <a class="hover:text-mustard transition-colors" href={`${base}privacy/`}>Privacy Policy</a>
        </div>
        <div class="flex items-center gap-1">
          <span>Developed by</span>
          <a href="https://www.linkedin.com/in/-gauravkalal-/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline decoration-accent/30 underline-offset-4 transition-all">Gaurav</a>
        </div>
      </div>
    </div>
  </div>
</footer>
