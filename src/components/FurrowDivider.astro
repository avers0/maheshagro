---
// Curved field furrows taken from the logo, used as a seam between two section colours.
// Pass top="transparent" with a negative top margin to let the section above show through.
interface Props {
  top?: string;
  bottom?: string;
  line?: string;
  flip?: boolean;
  class?: string;
}
const {
  top = 'var(--color-paper)',
  bottom = 'var(--color-paper-deep)',
  line = 'var(--color-mustard)',
  flip = false,
  class: className,
} = Astro.props;
---
<div aria-hidden="true" class:list={["furrow-divider", className]} style={flip ? 'transform:scaleX(-1);' : undefined}>
  <svg viewBox="0 0 1440 72" preserveAspectRatio="none" style="display:block;width:100%;height:clamp(32px,4.5vw,72px)">
    <path d="M0 0H1440V18C1080 56 520 70 0 44Z" fill={top} />
    <path d="M0 44C520 70 1080 56 1440 18V72H0Z" fill={bottom} />
    <path d="M0 56C520 82 1060 66 1440 30" fill="none" stroke={line} stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" opacity="0.7" />
    <path d="M0 68C560 92 1100 78 1440 46" fill="none" stroke={line} stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" opacity="0.35" />
  </svg>
</div>
