---
// Navbar.astro - Static shell, NavbarIsland handles interactivity
import NavbarIsland from '../islands/NavbarIsland';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const links = [
  [`${base}#about`, 'About Us'],
  [`${base}#why-choose-us`, 'Why Us'],
  [`${base}products`, 'Products'],
  [`${base}#testimonials`, 'Testimonials'],
  [`${base}#licenses`, 'Licenses'],
  [`${base}#locations`, 'Locations'],
  [`${base}#awards`, 'Awards'],
];
---
<nav id="main-nav" class="fixed w-full z-50 transition-all duration-500 py-2">
  <div class="container-custom flex items-center justify-between w-full">
    <!-- Logo -->
    <a href={base} class="flex items-center gap-3 group">
      <span class="w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-full bg-paper/95 p-1 shadow-soft group-hover:scale-105 transition-transform duration-500">
        <img src={`${base}Images/logo.png`} alt="Mahesh Agro Logo" class="w-full h-full object-contain" loading="eager" />
      </span>
      <span class="nav-link hidden sm:flex lg:hidden xl:flex flex-col whitespace-nowrap leading-none text-white">
        <span class="font-display text-lg font-semibold">Mahesh Agro</span>
        <span class="text-[10px] font-semibold uppercase tracking-[0.18em] opacity-75" data-language-static>Since 1973 · Dolta</span>
      </span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden lg:flex items-center gap-5 xl:gap-6">
      {links.map(([href, label]) => (
        <a href={href} class="nav-link whitespace-nowrap text-sm font-medium text-white/90 transition-colors hover:text-mustard">{label}</a>
      ))}
    </div>

    <!-- Desktop CTAs -->
    <div class="hidden lg:flex items-center gap-3">
      <button type="button" data-language-toggle class="nav-link nav-pill min-h-11 flex items-center gap-2 px-4 py-1.5 rounded-full border transition-all border-white/30 text-white hover:border-mustard focus-visible:outline-white" aria-label="Switch language to English" title="Switch language to English">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mustard" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        <span data-language-label class="text-sm font-semibold">English</span>
      </button>
      <a href="https://wa.me/919166029301" target="_blank" rel="noopener noreferrer" class="btn-accent !py-2 !px-5">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"/></svg>
        <span>WhatsApp Chat</span>
      </a>
    </div>

    <!-- Mobile hamburger (handled by NavbarIsland) -->
    <NavbarIsland client:load />
  </div>
</nav>
