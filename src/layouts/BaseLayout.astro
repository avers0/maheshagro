---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Backdrop from '../components/Backdrop.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Pages without a dark photo hero keep the paper navbar from the top. */
  solidNav?: boolean;
}

const {
  title = 'Mahesh Agro | Trusted Agriculture Retail Partner',
  description = 'Mahesh Agro provides quality seeds, fertilizers, and pesticides to farmers with expert guidance and trust. Serving farmers with authentic products since 1973.',
  ogTitle = 'Mahesh Agro | Trusted Agriculture Retail Partner',
  ogDescription = 'Quality seeds, fertilizers, and pesticides with expert guidance.',
  solidNav = false,
} = Astro.props;

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Mahesh Agro",
  "image": "https://maheshagro.com/Images/logo.png",
  "@id": "https://maheshagro.com",
  "url": "https://maheshagro.com",
  "telephone": "+919166029301",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "RTO Office, Jaipur-Kota Road, Madhosinghpura (Daulta)",
    "addressLocality": "Dolta",
    "addressRegion": "RJ",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 26, "longitude": 75.8 },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  },
  "sameAs": ["https://www.facebook.com/maheshagro","https://www.instagram.com/maheshagro"]
};
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Mahesh Agro" />
  <meta name="keywords" content="Mahesh Agro, Agriculture Retail, Seeds, Fertilizers, Pesticides, Farm Tools, Mandi Prices, Weather Forecast, Farmer Tools" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <link rel="icon" href={`${base}favicon.ico`} sizes="256x256" type="image/x-icon" />
  <meta name="theme-color" content="#1c3a27" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
</head>
<body data-solid-nav={solidNav ? 'true' : undefined}>
  <Backdrop />
  <Navbar />
  <slot />
  <Footer />
  <FloatingWhatsApp />
  <dialog id="language-dialog" class="language-dialog" aria-labelledby="language-dialog-title" data-language-static>
    <div class="language-dialog-content">
      <p class="language-dialog-kicker">LANGUAGE / भाषा</p>
      <h2 id="language-dialog-title">अपनी भाषा चुनें</h2>
      <p class="language-dialog-copy">Choose how you’d like to browse Mahesh Agro. You can change this later from the language button.</p>
      <div class="language-dialog-actions">
        <button type="button" data-language-choice="hi" lang="hi">हिन्दी</button>
        <button type="button" data-language-choice="en" lang="en">English</button>
      </div>
    </div>
  </dialog>
  <!-- Scroll reveal + nav scroll script -->
  <script>
    // Nav scroll behavior
    const nav = document.getElementById('main-nav');
    if (nav) {
      const solid = document.body.dataset.solidNav === 'true';
      const onScroll = () => {
        if (solid || window.scrollY > 50) nav.classList.add('nav-scrolled');
        else nav.classList.remove('nav-scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    // IntersectionObserver reveal (content stays visible without JS)
    document.documentElement.classList.add('js-reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal, .reveal-scale').forEach(el => observer.observe(el));
  </script>
  <script>
    import { initLanguage } from '../scripts/language';
    initLanguage();
  </script>
</body>
</html>
