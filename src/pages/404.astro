---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Page Not Found | Mahesh Agro" description="This page could not be found.">
  <main class="min-h-screen flex items-center justify-center bg-[#f8f5ef]">
    <div class="text-center px-6 py-32">
      <div class="text-9xl font-black text-primary mb-4">404</div>
      <h1 class="text-4xl font-bold text-primary mb-4">Page Not Found</h1>
      <p class="text-[#6b7a6e] text-lg mb-10 max-w-md mx-auto">The page you're looking for doesn't exist or has been moved.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-accent !text-sm !px-8 !py-4">Go Home</a>
        <a href="/products" class="btn-outline">Browse Products</a>
      </div>
    </div>
  </main>
</BaseLayout>
