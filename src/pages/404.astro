---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionKicker from '../components/SectionKicker.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="404 - Page Not Found | Mahesh Agro" description="This page could not be found." solidNav>
  <main class="paper-grain min-h-screen flex items-center justify-center surface-deep">
    <div class="text-center px-6 pt-36 pb-24">
      <svg class="mx-auto mb-8 w-64 text-primary" viewBox="0 0 260 120" fill="none" aria-hidden="true">
        <path d="M10 110C70 110 160 90 250 30" stroke="currentColor" stroke-width="6" stroke-linecap="round" opacity="0.25" />
        <path d="M40 112C100 110 180 92 250 60" stroke="var(--color-mustard)" stroke-width="5" stroke-linecap="round" opacity="0.6" />
        <path d="M90 114C150 112 210 100 250 86" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity="0.18" />
        <path d="M132 64V40" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <path d="M132 48c0-10-7-16-17-16 0 10 7 16 17 16Z" fill="var(--color-accent)" />
        <path d="M132 44c0-9 6-14 15-14 0 9-6 14-15 14Z" fill="var(--color-accent-dark)" />
      </svg>
      <SectionKicker hi="पेज नहीं मिला" en="Error 404" class="mb-5 justify-center" />
      <h1 class="text-[clamp(2.4rem,6vw,4rem)] leading-[1.05] text-primary mb-4">This field is still fallow</h1>
      <p class="text-text-muted text-lg mb-10 max-w-md mx-auto">The page you're looking for doesn't exist or has been moved.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={base} class="btn-accent">Go Home</a>
        <a href={`${base}products`} class="btn-outline">Browse Products</a>
      </div>
    </div>
  </main>
</BaseLayout>
