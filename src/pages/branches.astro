---
import BaseLayout from '../layouts/BaseLayout.astro';
import { branches } from '../data/branches';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
return Astro.redirect(`${base}#locations`);
---
<BaseLayout title="Branches | Mahesh Agro" description="Visit our physical stores for personalized consultation and genuine products.">
  <main class="min-h-screen bg-gray-50">
    <section class="pt-32 pb-16 bg-primary text-white">
      <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-black mb-6">Branches</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">Visit our physical stores for personalized consultation and genuine products.</p>
      </div>
    </section>
    <section class="py-16">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          {branches.map(b => (
            <div class="bg-white rounded-[3rem] shadow-xl border border-gray-100 overflow-hidden flex flex-col reveal-scale">
              <div class="h-64 w-full bg-gray-100">
                <iframe src={b.mapEmbed} width="100%" height="100%" style="border:0" loading="lazy" title={b.name}></iframe>
              </div>
              <div class="p-10 flex-grow">
                <div class="flex items-center gap-3 mb-6">
                  <div class="p-3 bg-primary/10 text-primary rounded-2xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                  </div>
                  <h2 class="text-2xl font-bold">{b.name}</h2>
                </div>
                <div class="space-y-6 mb-10">
                  <div class="flex items-start gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 mt-1 shrink-0" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                    <p class="text-gray-500 leading-relaxed">{b.address}</p>
                  </div>
                  <div class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 shrink-0" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                    <a href={`tel:${b.phone.replace(/\s/g,'')}`} class="font-bold hover:text-primary transition-colors">{b.phone}</a>
                  </div>
                  <div class="flex items-center gap-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 shrink-0" aria-hidden="true"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/></svg>
                    <p class="font-medium text-sm uppercase tracking-widest">{b.hours}</p>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <a href="https://wa.me/919166029301" class="flex items-center justify-center gap-2 bg-[#25D366] text-white py-4 rounded-2xl font-bold hover:shadow-lg transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
                    <span>WhatsApp</span>
                  </a>
                  <a href="tel:+919166029301" class="flex items-center justify-center gap-2 bg-primary text-white py-4 rounded-2xl font-bold hover:shadow-lg transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                    <span>Call Now</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
