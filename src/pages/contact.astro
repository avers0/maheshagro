---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormIsland from '../islands/ContactFormIsland';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
return Astro.redirect(`${base}#contact`);
---
<BaseLayout
  title="Contact Us | Mahesh Agro"
  description="Get in touch with Mahesh Agro. Call, WhatsApp, or visit our store for expert agricultural guidance."
>
  <main class="min-h-screen bg-gray-50">
    <section class="pt-32 pb-16 bg-primary text-white">
      <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-6xl font-black mb-6">Contact Us</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">Have questions? We're here to help. Contact us via phone, WhatsApp, or visit our store.</p>
      </div>
    </section>
    <section class="py-16">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
            <div class="lg:col-span-2 space-y-8">
              <div class="bg-white p-10 rounded-[2.5rem] shadow-xl border border-gray-100">
                <h2 class="text-2xl font-bold mb-8">Get in Touch</h2>
                <div class="space-y-8">
                  <a href="tel:+919166029301" class="block">
                    <div class="flex items-center gap-5 group cursor-pointer">
                      <div class="p-4 bg-gray-100 rounded-2xl group-hover:bg-primary/10 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                      </div>
                      <div>
                        <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">Call Us Directly</p>
                        <p class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors">+91 91660 29301</p>
                      </div>
                    </div>
                  </a>
                  <a href="https://wa.me/919166029301" class="block">
                    <div class="flex items-center gap-5 group cursor-pointer">
                      <div class="p-4 bg-gray-100 rounded-2xl group-hover:bg-primary/10 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#25D366]" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
                      </div>
                      <div>
                        <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">WhatsApp Chat</p>
                        <p class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors">Chat with Experts</p>
                      </div>
                    </div>
                  </a>
                  <a href="mailto:info@maheshagro.com" class="block">
                    <div class="flex items-center gap-5 group cursor-pointer">
                      <div class="p-4 bg-gray-100 rounded-2xl group-hover:bg-primary/10 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                      </div>
                      <div>
                        <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">Email Support</p>
                        <p class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors">info@maheshagro.com</p>
                      </div>
                    </div>
                  </a>
                  <div class="flex items-center gap-5">
                    <div class="p-4 bg-gray-100 rounded-2xl">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-red-500" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    </div>
                    <div>
                      <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-1">Our Address</p>
                      <p class="text-base font-bold text-gray-900">MAHESH AGRO SERVICE CENTRE DOLTA, RTO OFFICE, JAIPUR-KOTA ROAD, Madhosinghpura (Daulta)</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="bg-primary text-white p-10 rounded-[2.5rem] shadow-xl relative overflow-hidden">
                <h3 class="text-xl font-bold mb-4 relative z-10">Visit Our Store</h3>
                <p class="text-white/80 leading-relaxed mb-8 relative z-10">Experience our range of products and get face-to-face consultation at our main branch.</p>
                <a href={`${base}#locations`} class="inline-flex items-center gap-2 bg-white text-primary px-6 py-3 rounded-xl font-bold hover:scale-105 transition-transform relative z-10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>View Branches</span>
                </a>
              </div>
            </div>
            <div class="lg:col-span-3">
              <ContactFormIsland client:load />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
