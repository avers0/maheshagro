---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionKicker from '../components/SectionKicker.astro';
import FurrowDivider from '../components/FurrowDivider.astro';
import { brandPartners } from '../data/brandPartners';
import { testimonials } from '../data/testimonials';
import { branches } from '../data/branches';
import ContactFormIsland from '../islands/ContactFormIsland';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const mapsUrl = 'https://maps.app.goo.gl/sXBDyJkGtb8jekQXA';
const mainBranch = branches[0];

const awards = [
  { img: 'chambal-2011-12', brand: 'Chambal Fertilizers', title: 'Best Performance Award', year: '2011–12' },
  { img: 'corteva-2023', brand: 'Corteva Agriscience', title: 'Mark of Excellence Award', year: '2023' },
  { img: 'phn-2022', brand: 'PHN', title: 'Highest PHN Business Award', year: '2022' },
  { img: 'bayer-state-2025', brand: 'Bayer', title: 'State Level Award', year: '2025', wide: true },
  { img: 'wcw-platinum-2024-25', brand: 'WCW', title: 'Platinum Award for Highest Sales', year: '2024–25' },
  { img: 'bayer-trust-2024', brand: 'Bayer', title: 'Certificate of Appreciation for Trust', year: '2024' },
  { img: 'ipl-ceremony', brand: 'Indian Potash Limited', title: 'IPL Award Ceremony', year: '', wide: true },
];

const categories = [
  { label: 'Seeds', desc: 'Hybrid & open-pollinated varieties', group: 'Seeds', icon: 'seed' },
  { label: 'Fertilizers', desc: 'Macro & micronutrient solutions', group: 'Fertilizers', icon: 'bag' },
  { label: 'Pesticides', desc: 'Insecticides, fungicides & herbicides', group: 'Crop protection', icon: 'shield' },
  { label: 'Tools', desc: 'Sprayers, irrigation & more', group: 'Spray equipment', icon: 'spray' },
];

const seasons = [
  { id: 'rabi', name: 'Rabi', months: 'October – March', crops: 'Wheat, mustard, gram and barley', img: 'Wheat.png' },
  { id: 'kharif', name: 'Kharif', months: 'June – September', crops: 'Cotton, bajra, soybean and moong', img: 'Cotton.png' },
];

const reasons = [
  { icon: 'shield-check', title: 'Genuine Products', desc: '100% authentic seeds and chemicals directly from trusted manufacturers.' },
  { icon: 'lightbulb', title: 'Expert Guidance', desc: 'Personalized advice from experienced consultants to maximize your yield.' },
  { icon: 'users', title: 'Community Trust', desc: 'Serving 100000+ farmers across the region with dedication and care.' },
  { icon: 'award', title: 'Award Winning', desc: 'Recognized by leading brands like Chambal, Corteva, and Bayer for excellence.' },
];
---
<BaseLayout
  title="Mahesh Agro | Trusted Agriculture Retail Partner"
  description="Mahesh Agro provides quality seeds, fertilizers, and pesticides to farmers with expert guidance and trust. Serving farmers with authentic products since 1973."
>
  <main class="min-h-screen">

    <!-- ═══ HERO ═══ -->
    <section id="home" class="relative min-h-[100svh] flex items-end overflow-hidden pt-32 pb-16 md:pb-20">
      <div class="absolute inset-0 z-0">
        <picture>
          <source media="(max-width: 768px)" srcset={`${base}Images/MA/Outlet Pics_.jpg`} />
          <img src={`${base}Images/MA/Outlet Pics.jpg`} alt="Mahesh Agro Service Centre in Dolta" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        </picture>
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(15,31,21,0.92)_0%,rgba(15,31,21,0.75)_45%,rgba(15,31,21,0.25)_100%)]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f1f15] via-transparent to-[#0f1f15]/40"></div>
      </div>
      <div class="container-custom relative z-10 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
          <div class="lg:col-span-7 reveal">
            <SectionKicker hi="डोल्टा, राजस्थान" en="Since 1973" light class="mb-6" />
            <h1 class="text-white text-[clamp(2.6rem,6.5vw,5.25rem)] leading-[1.02] mb-6 max-w-3xl">
              Dolta's trusted farm store since 1973
            </h1>
            <p class="text-white/85 text-base md:text-lg mb-9 max-w-xl leading-relaxed">
              Leading agriculture retail partner providing 100% genuine seeds, fertilizers, and expert guidance to maximize your yield since 1973.
            </p>
            <div class="flex flex-wrap gap-3 items-center">
              <a href="https://wa.me/919166029301" target="_blank" rel="noopener noreferrer" class="btn-accent !px-7 !py-3.5">
                <span>WhatsApp Chat</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href={`${base}products`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/40 px-7 py-3 text-sm font-semibold text-white transition-colors hover:border-mustard hover:text-mustard">Browse All Products</a>
            </div>
          </div>

          <!-- Visit card -->
          <div class="lg:col-span-5 xl:col-span-4 xl:col-start-9 reveal">
            <div class="paper-grain rounded-[14px] bg-paper p-6 md:p-7 text-ink shadow-premium">
              <div class="flex items-center justify-between gap-3 mb-4">
                <h2 class="text-xl md:text-2xl text-primary">Visit our store</h2>
                <span class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold" data-open-chip>
                  <span class="h-2 w-2 rounded-full bg-current" aria-hidden="true"></span>
                  <span data-open-state="open" hidden>Open now</span>
                  <span data-open-state="closed" hidden>Closed now</span>
                </span>
              </div>
              <p class="text-sm leading-relaxed text-text-muted">{mainBranch.address}</p>
              <p class="mt-2 text-sm font-semibold text-primary"><span>Open daily</span> · <span>{mainBranch.hours}</span></p>
              <div class="mt-5 grid grid-cols-2 gap-2">
                <a href="tel:+919166029301" class="btn-primary justify-center !px-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg>
                  Call Now
                </a>
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-mustard justify-center !px-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                  Directions
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ BRAND PARTNERS MARQUEE ═══ -->
    <section id="brand-partners" class="bg-paper pt-14 pb-10 overflow-hidden">
      <div class="container-custom mb-8 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-xl md:text-2xl text-primary">Trusted Brand Partners</h2>
        <SectionKicker hi="भरोसेमंद ब्रांड" en={`${brandPartners.length} brands`} />
      </div>
      <div class="marquee-fade relative flex overflow-x-hidden">
        <div class="animate-marquee flex items-center gap-6 md:gap-8 whitespace-nowrap">
          {[...brandPartners, ...brandPartners].map((p, i) => (
            <div class="group flex flex-col items-center gap-3" aria-hidden={i >= brandPartners.length ? 'true' : undefined}>
              <div class="h-20 w-40 md:h-24 md:w-48 rounded-[12px] border border-border bg-[#fffdf8] flex items-center justify-center p-4 transition-all duration-500 group-hover:-translate-y-1 group-hover:shadow-card">
                <img src={`${base}${p.image.replace(/^\/+/, "")}`} alt={p.alt} class="max-h-full max-w-full object-contain mix-blend-multiply grayscale opacity-75 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100" loading="lazy" />
              </div>
              <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-soil/80">{p.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ ABOUT ═══ -->
    <section id="about" class="bg-paper pt-12 pb-20 md:pb-28">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <div class="lg:col-span-5 reveal-scale">
            <div class="relative">
              <div class="absolute -left-3 -bottom-3 h-full w-full rounded-[14px] border-2 border-mustard" aria-hidden="true"></div>
              <img src={`${base}Images/MA/Photo from Mudit Jindal(3).jpg`} alt="Farmers and Mahesh Agro team at the store" class="relative aspect-[4/3] lg:aspect-[4/5] w-full rounded-[14px] object-cover shadow-card" loading="lazy" />
            </div>
          </div>
          <div class="lg:col-span-7 reveal">
            <SectionKicker hi="हमारे बारे में" en="About us" class="mb-5" />
            <h2 class="text-primary text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] mb-6">Rooted on the Jaipur–Kota road since 1973</h2>
            <p class="text-text-muted text-base md:text-lg mb-8 max-w-2xl leading-relaxed">
              Mahesh Agro Service Centre (MASC) is a premier agricultural retail and consultancy firm dedicated to empowering farmers with high-quality inputs and scientific expertise. Founded in 1973, we provide genuine seeds, fertilizers, and pesticides from top global brands, ensuring maximum productivity and sustainability for every farm.
            </p>

            <!-- Ledger-style stats -->
            <dl class="grid grid-cols-1 sm:grid-cols-[1fr_1.45fr_1fr] border-y border-border divide-y sm:divide-y-0 sm:divide-x divide-border">
              <div class="py-5 sm:pr-6">
                <dd class="font-display text-[clamp(2.25rem,3.6vw,3rem)] text-primary leading-none whitespace-nowrap" data-language-static><span data-count="50">50</span><span class="text-mustard">+</span></dd>
                <dt class="mt-3 text-sm font-semibold text-ink">Years of Trust</dt>
              </div>
              <div class="py-5 sm:px-6">
                <dd class="font-display text-[clamp(2.25rem,3.6vw,3rem)] text-primary leading-none whitespace-nowrap" data-language-static><span data-count="100000">1,00,000</span><span class="text-mustard">+</span></dd>
                <dt class="mt-3 text-sm font-semibold text-ink">Customers Served</dt>
              </div>
              <div class="py-5 sm:pl-6">
                <dd class="font-display text-[clamp(2.25rem,3.6vw,3rem)] text-primary leading-none whitespace-nowrap" data-language-static><span data-count={brandPartners.length}>{brandPartners.length}</span><span class="text-mustard">+</span></dd>
                <dt class="mt-3 text-sm font-semibold text-ink">Brand Partners</dt>
              </div>
            </dl>

            <div class="mt-8 flex flex-wrap gap-3 items-center">
              <a href="https://wa.me/919166029301" target="_blank" rel="noopener noreferrer" class="btn-primary">Contact Experts</a>
              <a href="#why-choose-us" class="btn-outline">Learn More</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FurrowDivider top="var(--color-paper)" bottom="var(--color-paper-deep)" />

    <!-- ═══ WHY CHOOSE US ═══ -->
    <section id="why-choose-us" class="paper-grain bg-paper-deep pt-12 pb-20 md:pb-28">
      <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="order-2 lg:order-1">
            <div class="mb-10 reveal">
              <SectionKicker hi="हमें क्यों चुनें" en="Why choose us" class="mb-5" />
              <h2 class="text-primary text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] mb-4">Why farmers keep coming back</h2>
              <p class="text-text-muted text-base leading-relaxed max-w-lg">Empowering farmers across the region since 1973 with dedicated service.</p>
            </div>
            <ol class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-8">
              {reasons.map((item, i) => (
                <li class="reveal border-t border-primary/15 pt-5">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="font-display text-sm text-soil" data-language-static>{String(i + 1).padStart(2, '0')}</span>
                    <span class="w-10 h-10 rounded-full bg-mustard/25 flex items-center justify-center text-primary">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        {item.icon === "shield-check" && <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></>}
                        {item.icon === "lightbulb" && <><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></>}
                        {item.icon === "users" && <><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></>}
                        {item.icon === "award" && <><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></>}
                      </svg>
                    </span>
                  </div>
                  <h3 class="text-xl text-primary mb-2">{item.title}</h3>
                  <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
                </li>
              ))}
            </ol>
          </div>
          <div class="order-1 lg:order-2 reveal-scale">
            <div class="relative">
              <div class="absolute -right-3 -top-3 h-full w-full rounded-[14px] bg-primary" aria-hidden="true"></div>
              <img src={`${base}Images/MA/Outlet Pics_.jpg`} alt="Agricultural products stocked at Mahesh Agro" class="relative w-full rounded-[14px] shadow-card" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <FurrowDivider top="var(--color-paper-deep)" bottom="var(--color-paper)" flip />

    <!-- ═══ PRODUCTS PREVIEW ═══ -->
    <section id="products" class="bg-paper pt-12 pb-20 md:pb-28">
      <div class="container-custom">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 reveal">
          <div class="max-w-2xl">
            <SectionKicker hi="उत्पाद" en="Our products" class="mb-5" />
            <h2 class="text-primary text-[clamp(2rem,4vw,3.25rem)] leading-[1.08] mb-4">Everything for the season, under one roof</h2>
            <p class="text-text-muted text-base leading-relaxed">From seeds to fertilizers and pesticides — everything your farm needs, sourced from trusted global brands.</p>
          </div>
          <a href={`${base}products`} class="btn-accent self-start lg:self-auto">Browse All Products</a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-14">
          {categories.map(cat => (
            <a href={`${base}products?category=${encodeURIComponent(cat.group)}#catalogue`} class="card-paper group relative flex flex-col justify-between gap-8 overflow-hidden p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-mustard reveal-scale">
              <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-mustard transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
              <span class="w-12 h-12 rounded-full bg-primary text-paper flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {cat.icon === 'seed' && <><path d="M12 22V12"/><path d="M12 12C12 7 8 4 3 4c0 5 3.5 8 9 8Z"/><path d="M12 12c0-4 3-7 8-7 0 4.5-3 7-8 7Z"/></>}
                  {cat.icon === 'bag' && <><path d="M6 3h12l-1 4H7Z"/><path d="M7 7c-2 3-2 10 0 14h10c2-4 2-11 0-14"/><path d="M9.5 13.5h5"/></>}
                  {cat.icon === 'shield' && <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v8"/><path d="M8.5 12h7"/></>}
                  {cat.icon === 'spray' && <><path d="M10 8h5v13H8V10a2 2 0 0 1 2-2Z"/><path d="M12 8V4h4"/><path d="M19 3v.01"/><path d="M21 5v.01"/><path d="M19 7v.01"/></>}
                </svg>
              </span>
              <span>
                <span class="block font-display text-xl md:text-2xl text-primary">{cat.label}</span>
                <span class="mt-1.5 block text-sm leading-relaxed text-text-muted">{cat.desc}</span>
              </span>
            </a>
          ))}
        </div>

        <!-- What's in season -->
        <div class="reveal">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
            <h3 class="text-2xl md:text-3xl text-primary">What's in season</h3>
            <p class="text-sm text-text-muted">Plan your inputs before sowing starts.</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {seasons.map(season => (
              <article class="season-card group relative flex min-h-56 overflow-hidden rounded-[14px] border border-border bg-primary text-white" data-season={season.id}>
                <img src={`${base}Images/${season.img}`} alt="" class="absolute inset-0 h-full w-full object-cover opacity-60 transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-r from-[#0f1f15]/90 via-[#0f1f15]/60 to-transparent" aria-hidden="true"></div>
                <div class="relative flex flex-col justify-end p-6 md:p-8">
                  <span class="season-badge mb-auto self-start rounded-full bg-mustard px-3 py-1 text-xs font-bold text-ink" hidden>In season now</span>
                  <p class="mt-8 text-xs font-semibold uppercase tracking-[0.16em] text-mustard-soft">{season.months}</p>
                  <h4 class="font-display text-4xl md:text-5xl mt-1">{season.name}</h4>
                  <p class="mt-2 max-w-xs text-sm text-white/85">{season.crops}</p>
                </div>
              </article>
            ))}
          </div>
          <p class="mt-5 text-sm text-text-muted">
            <a href="https://wa.me/919166029301" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary underline decoration-mustard decoration-2 underline-offset-4 hover:text-soil">Ask us on WhatsApp</a>
            <span> what your field needs this season.</span>
          </p>
        </div>
      </div>
    </section>

    <FurrowDivider top="var(--color-paper)" bottom="var(--color-paper-deep)" />

    <!-- ═══ TESTIMONIALS ═══ -->
    <section id="testimonials" class="paper-grain bg-paper-deep pt-12 pb-20 md:pb-28">
      <div class="container-custom">
        <div class="mb-12 reveal text-center">
          <SectionKicker hi="किसानों की राय" en="Testimonials" class="mb-5 justify-center" />
          <h2 class="text-primary text-[clamp(2rem,4vw,3.25rem)] leading-[1.08]">What Farmers Say</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
          {testimonials.map((t, i) => (
            <figure class:list={["card-paper relative p-7 md:p-9 reveal transition-transform duration-300 hover:rotate-0", i % 2 === 0 ? "md:-rotate-[0.6deg]" : "md:rotate-[0.6deg]"]}>
              <span class="absolute -top-5 left-6 font-display text-7xl leading-none text-mustard" aria-hidden="true">“</span>
              <div class="flex gap-1 mb-4" aria-label={`${t.rating} out of 5`}>
                {Array(t.rating).fill(0).map(() => (
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="text-mustard" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                ))}
              </div>
              <blockquote class="font-display text-lg md:text-xl leading-relaxed text-ink mb-6">{t.quote}</blockquote>
              <figcaption class="flex items-center gap-3 border-t border-dashed border-border pt-5">
                <span class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-paper font-display font-semibold">{t.name[0]}</span>
                <span>
                  <span class="block font-semibold text-primary text-sm">{t.name}</span>
                  <span class="block text-text-muted text-xs">{t.location}{t.crop ? ` · ${t.crop}` : ""}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <FurrowDivider top="var(--color-paper-deep)" bottom="var(--color-paper)" flip />

    <!-- ═══ LICENSES ═══ -->
    <section id="licenses" class="bg-paper pt-12 pb-20 md:pb-28">
      <div class="container-custom">
        <div class="grid xl:grid-cols-12 gap-10 items-start">
          <div class="xl:col-span-4 reveal">
            <SectionKicker hi="लाइसेंस" en="Licenses" class="mb-5" />
            <h2 class="text-primary text-[clamp(2rem,4vw,3rem)] leading-[1.08] mb-4">Licensed & Certified</h2>
            <p class="text-text-muted text-base leading-relaxed mb-8">Fully licensed agriculture retail partner operating under all regulatory guidelines.</p>
            <a href="#contact" class="btn-outline">Ask About Our Licenses</a>
          </div>
          <div class="xl:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
            {[
              { title: "Pesticide License", no: "RJ-JP-0XXX", issuer: "Dept. of Agriculture, Rajasthan", icon: "shield" },
