  <script>
    // Open-now chip, using the store's local time (IST) and the hours from branches.ts (9 AM – 8 PM).
    const chip = document.querySelector<HTMLElement>('[data-open-chip]');
    if (chip) {
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
      const open = hour >= 9 && hour < 20;
      chip.querySelector<HTMLElement>(`[data-open-state="${open ? 'open' : 'closed'}"]`)?.removeAttribute('hidden');
      chip.classList.add(...(open ? ['bg-accent/25', 'text-primary'] : ['bg-soil/15', 'text-soil']));
    }

    // Highlight the current sowing season: Rabi Oct–Mar, Kharif Apr–Sep (incl. pre-monsoon prep).
    const month = new Date().getMonth() + 1;
    const current = month >= 10 || month <= 3 ? 'rabi' : 'kharif';
    document.querySelector(`[data-season="${current}"] .season-badge`)?.removeAttribute('hidden');
    document.querySelector(`[data-season="${current}"]`)?.classList.add('ring-2', 'ring-mustard', 'ring-offset-2', 'ring-offset-paper');

    // Count-up stats in Indian number format.
    const counters = document.querySelectorAll<HTMLElement>('[data-count]');
    if (counters.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const format = (n: number) => n.toLocaleString('en-IN');
      const run = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / 1400, 1);
          el.textContent = format(Math.round(target * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
      }), { threshold: 0.6 });
      counters.forEach(el => io.observe(el));
    }
  </script>
