---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Legal | Mahesh Agro" description="Terms & Conditions and Privacy Policy of Mahesh Agro Service Centre.">
  <main class="min-h-screen bg-[#f8f5ef]">
    <section class="pt-32 pb-16 bg-primary text-white relative overflow-hidden">
      <div class="container-custom relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
          <span class="text-xs font-bold uppercase tracking-widest">Legal Information</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-4">Trust & Transparency</h1>
        <p class="text-white/60 max-w-2xl mx-auto text-sm md:text-base">Our commitment to your security and the ethical standards of our agricultural partnership.</p>
      </div>
    </section>
    <section class="py-16 md:py-24">
      <div class="container-custom">
        <div class="flex flex-col lg:flex-row gap-12">
          <aside class="lg:w-1/4">
            <div class="sticky top-32 space-y-2">
              <a href="/legal" class="w-full flex items-center justify-between p-4 rounded-2xl border bg-white border-accent shadow-premium text-primary">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-accent text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"/><path d="M7 21h10"/></svg>
                  </div>
                  <span class="font-bold text-sm">Terms & Conditions</span>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
              <a href="/privacy" class="w-full flex items-center justify-between p-4 rounded-2xl border bg-white/50 border-gray-200 text-primary/60 hover:border-accent/50">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center bg-primary/5 text-primary/40">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  </div>
                  <span class="font-bold text-sm">Privacy Policy</span>
                </div>
              </a>
            </div>
          </aside>
          <div class="lg:w-3/4">
            <div class="bg-white rounded-[2.5rem] border border-gray-200 p-8 md:p-12 shadow-premium">
              <div class="flex items-center gap-4 mb-10">
                <div class="w-12 h-12 bg-accent/20 rounded-2xl flex items-center justify-center text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1"/><path d="M7 21h10"/></svg>
                </div>
                <div>
                  <h2 class="text-3xl font-bold text-primary tracking-tight">Terms & Conditions</h2>
                  <p class="text-[#6b7a6e] text-xs font-medium uppercase tracking-widest mt-1">Last Updated: April 2026</p>
                </div>
              </div>
              <div class="space-y-10">
                {[
                  { title: "1. Acceptance of Terms", text: "By accessing and using the Mahesh Agro Service Centre website, you agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, you must not use our website or services." },
                  { title: "2. Services and Products", text: "Mahesh Agro provides agricultural consultancy and retail services. While we strive to provide accurate information regarding seeds, fertilizers, and pesticides, the results may vary based on soil conditions, weather, and application methods. All products sold are subject to the manufacturer's warranty and terms." },
                  { title: "3. User Conduct", text: "Users agree to use the website only for lawful purposes. You are prohibited from attempting to interfere with the website's security, providing false information, or using the contact information for unsolicited marketing." },
                  { title: "4. Intellectual Property", text: "All content on this website, including text, graphics, logos, and images, is the property of Mahesh Agro Service Centre and is protected by Indian and international copyright laws." },
                  { title: "5. Limitation of Liability", text: "Mahesh Agro shall not be liable for any indirect, incidental, or consequential damages resulting from the use or inability to use our services or products. Our liability is limited to the maximum extent permitted by law." },
                  { title: "6. Governing Law", text: "These terms are governed by the laws of India. Any disputes arising from these terms or your use of the website shall be subject to the exclusive jurisdiction of the courts in Jaipur, Rajasthan." },
                ].map(clause => (
                  <div class="group">
                    <h3 class="text-xl font-bold text-primary mb-4 group-hover:text-accent transition-colors">{clause.title}</h3>
                    <p class="text-[#6b7a6e] leading-relaxed text-base md:text-lg font-normal">{clause.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
