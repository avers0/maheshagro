---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const clauses = [
                  { title: "1. Acceptance of Terms", text: "By accessing and using the Mahesh Agro Service Centre website, you agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, you must not use our website or services." },
                  { title: "2. Services and Products", text: "Mahesh Agro provides agricultural consultancy and retail services. While we strive to provide accurate information regarding seeds, fertilizers, and pesticides, the results may vary based on soil conditions, weather, and application methods. All products sold are subject to the manufacturer's warranty and terms." },
                  { title: "3. User Conduct", text: "Users agree to use the website only for lawful purposes. You are prohibited from attempting to interfere with the website's security, providing false information, or using the contact information for unsolicited marketing." },
                  { title: "4. Intellectual Property", text: "All content on this website, including text, graphics, logos, and images, is the property of Mahesh Agro Service Centre and is protected by Indian and international copyright laws." },
                  { title: "5. Limitation of Liability", text: "Mahesh Agro shall not be liable for any indirect, incidental, or consequential damages resulting from the use or inability to use our services or products. Our liability is limited to the maximum extent permitted by law." },
                  { title: "6. Governing Law", text: "These terms are governed by the laws of India. Any disputes arising from these terms or your use of the website shall be subject to the exclusive jurisdiction of the courts in Jaipur, Rajasthan." },
];
---
<BaseLayout title="Legal | Mahesh Agro" description="Terms & Conditions and Privacy Policy of Mahesh Agro Service Centre." solidNav>
  <main class="min-h-screen bg-paper">
    <PageHero kickerHi="कानूनी जानकारी" kickerEn="Legal" title="Trust & Transparency" intro="Our commitment to your security and the ethical standards of our agricultural partnership." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <nav class="mb-10 flex flex-wrap gap-2" aria-label="Legal pages">
          <a href={`${base}legal/`} class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white" aria-current="page">Terms & Conditions</a>
          <a href={`${base}privacy/`} class="rounded-full border border-border bg-[#fffdf8] px-5 py-2 text-sm font-semibold text-primary hover:border-mustard">Privacy Policy</a>
        </nav>
        <article class="card-paper prose-heritage p-7 md:p-12">
          <header class="mb-10 border-b border-border pb-6">
            <h2 class="!text-3xl">Terms & Conditions</h2>
            <p class="!mt-2 text-xs font-semibold uppercase tracking-[0.14em] !text-soil">Last Updated: April 2026</p>
          </header>
          {clauses.map(clause => (
            <section>
              <h3 class="mb-3 text-xl text-primary">{clause.title}</h3>
              <p>{clause.text}</p>
            </section>
          ))}
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
