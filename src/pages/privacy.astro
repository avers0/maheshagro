---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy Policy | Mahesh Agro" description="Privacy Policy of Mahesh Agro Service Centre.">
  <main class="min-h-screen bg-[#f8f5ef]">
    <section class="pt-32 pb-16 bg-primary text-white">
      <div class="container-custom text-center">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-4">Privacy Policy</h1>
        <p class="text-white/60 max-w-xl mx-auto">How we collect, use, and protect your information.</p>
      </div>
    </section>
    <section class="py-16 md:py-24">
      <div class="container-custom max-w-4xl">
        <div class="bg-white rounded-[2.5rem] border border-gray-200 p-8 md:p-12 shadow-premium">
          <div class="flex items-center gap-4 mb-10">
            <div class="w-12 h-12 bg-primary/10 rounded-2xl flex items-center justify-center text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
              <h2 class="text-3xl font-bold text-primary">Privacy Policy</h2>
              <p class="text-[#6b7a6e] text-xs uppercase tracking-widest mt-1">Last Updated: April 2026</p>
            </div>
          </div>
          <div class="space-y-10">
            {[
              { title: "1. Information We Collect", text: "We collect information you provide directly to us, such as your name and phone number when you contact us through our website or WhatsApp. We also collect usage data to improve our services." },
              { title: "2. How We Use Your Information", text: "We use the information we collect to respond to your inquiries, provide product recommendations and agricultural advice, and improve our services. We do not sell your personal information to third parties." },
              { title: "3. Information Sharing", text: "We may share your information with our staff members who need access to provide our services. We may also disclose information when required by law or to protect our legal rights." },
              { title: "4. Data Security", text: "We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction." },
              { title: "5. WhatsApp Communication", text: "When you communicate with us via WhatsApp, your messages are subject to WhatsApp's privacy policy in addition to ours. We use WhatsApp only for agricultural consultation and product inquiries." },
              { title: "6. Your Rights", text: "You have the right to access, correct, or delete your personal information. To exercise these rights, please contact us at contact@maheshagro.com or call +91 91660 29301." },
              { title: "7. Contact Us", text: "If you have questions about this Privacy Policy, please contact us at MAHESH AGRO SERVICE CENTRE DOLTA, RTO OFFICE, JAIPUR-KOTA ROAD, Madhosinghpura (Daulta), Rajasthan." },
            ].map(clause => (
              <div class="group">
                <h3 class="text-xl font-bold text-primary mb-4 group-hover:text-accent transition-colors">{clause.title}</h3>
                <p class="text-[#6b7a6e] leading-relaxed text-base md:text-lg font-normal">{clause.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
