---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const clauses = [
  { title: "1. Information We Collect", text: "We collect information you provide directly to us, such as your name and phone number when you contact us through our website or WhatsApp. We also collect usage data to improve our services." },
  { title: "2. How We Use Your Information", text: "We use the information we collect to respond to your inquiries, provide product recommendations and agricultural advice, and improve our services. We do not sell your personal information to third parties." },
  { title: "3. Information Sharing", text: "We may share your information with our staff members who need access to provide our services. We may also disclose information when required by law or to protect our legal rights." },
  { title: "4. Data Security", text: "We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction." },
  { title: "5. WhatsApp Communication", text: "When you communicate with us via WhatsApp, your messages are subject to WhatsApp's privacy policy in addition to ours. We use WhatsApp only for agricultural consultation and product inquiries." },
  { title: "6. Your Rights", text: "You have the right to access, correct, or delete your personal information. To exercise these rights, please contact us at rohit.krml@yahoo.com or call +91 91660 29301." },
  { title: "7. Contact Us", text: "If you have questions about this Privacy Policy, please contact us at Mahesh Agro Service Centre, RTO Office, Jaipur-Kota Road, Madhosinghpura (Daulta), Tonk (Raj.)." },
];
---
<BaseLayout title="Privacy Policy | Mahesh Agro" description="Privacy Policy of Mahesh Agro Service Centre." solidNav>
  <main class="min-h-screen">
    <PageHero kickerHi="गोपनीयता" kickerEn="Legal" title="Privacy Policy" intro="How we collect, use, and protect your information." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <nav class="mb-10 flex flex-wrap gap-2" aria-label="Legal pages">
          <a href={`${base}legal/`} class="rounded-full border border-border bg-[#fffdf8] px-5 py-2 text-sm font-semibold text-primary hover:border-mustard">Terms & Conditions</a>
          <a href={`${base}privacy/`} class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white" aria-current="page">Privacy Policy</a>
        </nav>
        <article class="card-paper prose-heritage p-7 md:p-12">
          <header class="mb-10 border-b border-border pb-6">
            <h2 class="!text-3xl">Privacy Policy</h2>
            <p class="!mt-2 text-xs font-semibold uppercase tracking-[0.14em] !text-soil">Last Updated: April 2026</p>
          </header>
          {clauses.map(clause => (
            <section>
              <h3 class="mb-3 text-xl text-primary">{clause.title}</h3>
              <p>{clause.text}</p>
            </section>
          ))}
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
