---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductsIsland from '../islands/ProductsIsland';
import PageHero from '../components/PageHero.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const categories = [
  { name: 'Seeds', detail: 'Options for the crops you grow', icon: 'seed' },
  { name: 'Fertilizers', detail: 'Crop nutrition and soil inputs', icon: 'bag' },
  { name: 'Crop protection', detail: 'Pesticides and crop care', icon: 'shield' },
  { name: 'Spray equipment', detail: 'Tools for applying crop inputs', icon: 'spray' },
];
---
<BaseLayout
  title="Products | Mahesh Agro"
  description="Explore seeds, fertilizers, crop protection, and spray equipment at Mahesh Agro. Contact our team to confirm product availability."
  solidNav
>
  <main class="min-h-screen bg-paper">
    <PageHero kickerHi="उत्पाद" kickerEn="Products" title="Find the right inputs for your farm" intro="Explore product categories and talk with our team about options for your crop. We can help you confirm details and availability.">
      <a href="#product-categories-heading" class="btn-accent justify-center">Explore categories</a>
      <a href="https://wa.me/919166029301?text=Hi%2C%20I%20would%20like%20help%20finding%20an%20agricultural%20product." target="_blank" rel="noopener noreferrer" class="btn-outline">Ask our team</a>
    </PageHero>

    <section class="container-custom pt-6 pb-16 md:pb-20" aria-labelledby="product-categories-heading">
      <div class="mb-8 max-w-2xl">
        <h2 id="product-categories-heading" class="scroll-mt-28 text-[clamp(1.75rem,3vw,2.5rem)] text-primary">Browse by need</h2>
        <p class="mt-3 leading-relaxed text-text-muted">Start with the type of product you need. Our team can help you narrow down the options.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((item) => (
          <a href={`${base}products?category=${encodeURIComponent(item.name)}#catalogue`} class="card-paper group relative flex min-h-52 flex-col justify-between overflow-hidden p-6 text-primary transition-all duration-300 hover:-translate-y-1 hover:border-mustard">
            <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-mustard transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary text-paper">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {item.icon === 'seed' && <><path d="M12 22V12"/><path d="M12 12C12 7 8 4 3 4c0 5 3.5 8 9 8Z"/><path d="M12 12c0-4 3-7 8-7 0 4.5-3 7-8 7Z"/></>}
                {item.icon === 'bag' && <><path d="M6 3h12l-1 4H7Z"/><path d="M7 7c-2 3-2 10 0 14h10c2-4 2-11 0-14"/><path d="M9.5 13.5h5"/></>}
                {item.icon === 'shield' && <><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v8"/><path d="M8.5 12h7"/></>}
                {item.icon === 'spray' && <><path d="M10 8h5v13H8V10a2 2 0 0 1 2-2Z"/><path d="M12 8V4h4"/><path d="M19 3v.01"/><path d="M21 5v.01"/><path d="M19 7v.01"/></>}
              </svg>
            </span>
            <span>
              <span class="block font-display text-2xl">{item.name}</span>
              <span class="mt-2 block text-sm text-text-muted">{item.detail}</span>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-soil">Ask about options <span aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section id="catalogue" class="paper-grain scroll-mt-24 border-t border-border bg-paper-deep py-16 md:py-20" aria-labelledby="catalogue-heading">
      <div class="container-custom mb-8 flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <h2 id="catalogue-heading" class="text-[clamp(1.75rem,3vw,2.5rem)] text-primary">Find a product</h2>
          <p class="mt-3 max-w-2xl leading-relaxed text-text-muted">Browse products and listed prices. Confirm the latest price and availability with our team before buying.</p>
        </div>
        <a href="tel:+919166029301" class="inline-flex min-h-11 shrink-0 items-center font-semibold text-primary underline decoration-mustard decoration-2 underline-offset-4 hover:text-soil">Call +91 91660 29301</a>
      </div>
      <ProductsIsland client:load />
    </section>
  </main>
</BaseLayout>
