---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms & Conditions | Mahesh Agro" description="Terms and Conditions of Mahesh Agro Service Centre.">
  <main class="min-h-screen bg-[#f8f5ef]">
    <section class="pt-32 pb-16 bg-primary text-white">
      <div class="container-custom text-center">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-4">Terms & Conditions</h1>
        <p class="text-white/60 max-w-xl mx-auto">The rules and guidelines governing the use of our services.</p>
      </div>
    </section>
    <section class="py-16 md:py-24">
      <div class="container-custom max-w-4xl">
        <div class="bg-white rounded-[2.5rem] border border-gray-200 p-8 md:p-12 shadow-premium">
          <div class="space-y-10">
            {[
              { title: "1. Acceptance of Terms", text: "By accessing and using the Mahesh Agro Service Centre website, you agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, you must not use our website or services." },
              { title: "2. Services and Products", text: "Mahesh Agro provides agricultural consultancy and retail services. While we strive to provide accurate information regarding seeds, fertilizers, and pesticides, the results may vary based on soil conditions, weather, and application methods." },
              { title: "3. User Conduct", text: "Users agree to use the website only for lawful purposes. You are prohibited from attempting to interfere with the website's security, providing false information, or using the contact information for unsolicited marketing." },
              { title: "4. Intellectual Property", text: "All content on this website, including text, graphics, logos, and images, is the property of Mahesh Agro Service Centre and is protected by Indian and international copyright laws." },
              { title: "5. Limitation of Liability", text: "Mahesh Agro shall not be liable for any indirect, incidental, or consequential damages resulting from the use or inability to use our services or products." },
              { title: "6. Governing Law", text: "These terms are governed by the laws of India. Any disputes shall be subject to the exclusive jurisdiction of the courts in Jaipur, Rajasthan." },
            ].map(clause => (
              <div class="group">
                <h3 class="text-xl font-bold text-primary mb-4 group-hover:text-accent transition-colors">{clause.title}</h3>
                <p class="text-[#6b7a6e] leading-relaxed text-base md:text-lg font-normal">{clause.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
