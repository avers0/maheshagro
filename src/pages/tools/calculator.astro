---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CalculatorIsland from '../../islands/CalculatorIsland';
---
<BaseLayout title="Fertilizer Calculator | Mahesh Agro Tools" description="Calculate the right fertilizer quantity for your crop and field area." solidNav>
  <main class="min-h-screen">
    <PageHero kickerHi="खाद कैलकुलेटर" kickerEn="Farmer tools" title="Fertilizer Calculator" intro="Calculate the ideal fertilizer quantities for your crop and field size." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <CalculatorIsland client:load />
      </div>
    </section>
  </main>
</BaseLayout>
