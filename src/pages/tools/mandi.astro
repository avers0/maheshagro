---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MandiIsland from '../../islands/MandiIsland';
---
<BaseLayout title="Mandi Prices | Mahesh Agro Tools" description="Check today's agricultural commodity prices at local mandis in Rajasthan." solidNav>
  <main class="min-h-screen bg-paper">
    <PageHero kickerHi="मंडी भाव" kickerEn="Farmer tools" title="Mandi Prices" intro="Stay updated with today's agricultural commodity prices at local mandis." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <MandiIsland client:load />
      </div>
    </section>
  </main>
</BaseLayout>
