---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MandiIsland from '../../islands/MandiIsland';
---
<BaseLayout title="Mandi Prices | Mahesh Agro Tools" description="Reference prices for major crops at mandis near Deoli and Tonk, with a link to today's official rates." solidNav>
  <main class="min-h-screen">
    <PageHero kickerHi="मंडी भाव" kickerEn="Farmer tools" title="Mandi Prices" intro="Reference prices for major crops at nearby mandis. For today's rates, call us or check Agmarknet." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <MandiIsland client:load />
      </div>
    </section>
  </main>
</BaseLayout>
