---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeatherIsland from '../../islands/WeatherIsland';
---
<BaseLayout title="Weather Forecast | Mahesh Agro Tools" description="Check current weather conditions for major agricultural regions in Rajasthan.">
  <main class="min-h-screen bg-gray-50">
    <section class="pt-32 pb-16 bg-primary text-white">
      <div class="container mx-auto px-6 text-center">
        <h1 class="text-4xl md:text-5xl font-black mb-4">Weather Forecast</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">Check current weather conditions and farming advisories for your region.</p>
      </div>
    </section>
    <section class="py-16">
      <div class="container mx-auto px-6">
        <WeatherIsland client:load />
      </div>
    </section>
  </main>
</BaseLayout>
