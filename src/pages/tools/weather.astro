---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WeatherIsland from '../../islands/WeatherIsland';
---
<BaseLayout title="Weather Forecast | Mahesh Agro Tools" description="Check current weather conditions for major agricultural regions in Rajasthan." solidNav>
  <main class="min-h-screen">
    <PageHero kickerHi="मौसम" kickerEn="Farmer tools" title="Weather Forecast" intro="Check current weather conditions and farming advisories for your region." />
    <section class="pb-24 pt-4">
      <div class="container-custom">
        <WeatherIsland client:load />
      </div>
    </section>
  </main>
</BaseLayout>
